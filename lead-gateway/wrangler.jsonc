{
  "name": "glattai-leads-review",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "observability": { "enabled": false },
  "vars": {
    "ENVIRONMENT": "preview",
    "ENABLED": "true",
    "ALLOWED_ORIGINS": "[\"https://glatt-ai-preview.vercel.app\"]"
  },
  "ratelimits": [
    {
      "name": "LEAD_RATE_LIMITER",
      "namespace_id": "2026101501",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "2026101502",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
